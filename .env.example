# Copy this file to .env and set the value locally.
# Never commit .env or share the API key.
GNANI_API_KEY=your_gnani_api_key_here

# Optional application settings
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_PATH=/stt/v3
GNANI_MODEL=prisma-v3.0
GNANI_LANGUAGE_CODE=kn-IN,en-IN
GNANI_FORMAT=codemix
GNANI_TIMEOUT_SECONDS=60
MAX_UPLOAD_SIZE_BYTES=26214400
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Live microphone: realtime accepts one language (defaults to the first above)
# GNANI_STREAM_LANGUAGE_CODE=kn-IN
# STREAM_MAX_SECONDS=600
# STREAM_MAX_SESSIONS=1

# Public deployments: require an access code and cap daily usage
# NAADI_ACCESS_CODE=choose-a-long-code
# NAADI_DAILY_TRANSCRIPTIONS=150
# NAADI_DAILY_LIVE_MINUTES=60
# NAADI_DAILY_TTS=60

# Saved call log (SQLite)
# NAADI_DB_PATH=data/naadi.sqlite3
